server {
    listen 80;
    server_name _;

    # Keep redirects relative so the browser preserves the original host:port.
    # Under Docker port mapping nginx listens on 80 internally but is reached on
    # a different published port, and an absolute redirect would wrongly point at
    # :80. A relative Location is resolved against the request URL instead.
    absolute_redirect off;

    # Visiting /cookie sets a prebaked pan-domain auth cookie (generated from the
    # static local test key when this image is built) and redirects to the app,
    # giving developers an authenticated session without running the real OAuth
    # flow locally. The cookie value is templated in at build time; the nginx
    # $variables below are left untouched because envsubst is scoped to that one
    # token.
    location = /cookie {
        add_header Set-Cookie "gutoolsAuth-assym=${PAN_DOMAIN_COOKIE}; Path=/; SameSite=Lax" always;
        return 302 /;
    }

    location / {
        proxy_pass http://restorer:9000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
