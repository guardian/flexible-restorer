#!/usr/bin/env bash

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT_DIR=${DIR}/../..

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker CLI is required to run the local stack command" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop (or your Docker daemon) and try again." >&2
  exit 1
fi

# Ensure the Chromium browser Playwright launches is present (no-op once installed).
npm exec playwright install chromium

node "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/e2e-tests/images/run-local-stack.ts" "$@" || {
  exit_code=$?
  # Exit code 130 means the process was interrupted by Ctrl+C (SIGINT), which is expected.
  if [ "$exit_code" -eq 130 ]; then
    exit 0
  fi
  exit "$exit_code"
}
