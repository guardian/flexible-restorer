#!/usr/bin/env bash

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT_DIR=${DIR}/../..
NODE_VERSION="${LOCAL_STACK_NODE_VERSION:-20}"
NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

if [ ! -s "$NVM_DIR/nvm.sh" ]; then
  echo "nvm is required to run the local stack command" >&2
  exit 1
fi

# shellcheck disable=SC1090
. "$NVM_DIR/nvm.sh"

nvm exec "$NODE_VERSION" "$ROOT_DIR/node_modules/.bin/tsx" "$ROOT_DIR/scripts/docker/run-local-stack.ts" "$@"
