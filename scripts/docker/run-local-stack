#!/usr/bin/env bash

set -euo pipefail

DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
ROOT_DIR=${DIR}/../..
E2E_DIR="${ROOT_DIR}/tests"

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker CLI is required to run the local stack command" >&2
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker is not running. Start Docker Desktop (or your Docker daemon) and try again." >&2
  exit 1
fi

# shellcheck disable=SC1090

# The e2e tooling (tsx, @playwright/test, testcontainers) lives in the tests/
# sub-package. Ensure it's installed, then resolve modules from there while
# keeping the working directory at the repo root so the runner's
# `process.cwd()` (used as the Docker build context) stays correct. Node is
# provided by mise locally (see .tool-versions); this script no longer manages it.
if [ ! -x "$E2E_DIR/node_modules/.bin/tsx" ]; then
  npm --prefix "$E2E_DIR" install >/dev/null
fi

cd "$ROOT_DIR"
NODE_PATH="$E2E_DIR/node_modules" "$E2E_DIR/node_modules/.bin/tsx" "$ROOT_DIR/scripts/docker/run-local-stack.ts" "$@" || {
  exit_code=$?
  # Exit code 130 means the process was interrupted by Ctrl+C (SIGINT), which is expected.
  if [ "$exit_code" -eq 130 ]; then
    exit 0
  fi
  exit "$exit_code"
}
