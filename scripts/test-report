#!/usr/bin/env bash

set -euo pipefail

# The Cucumber HTML report lives in the e2e sub-package (tests/) and is served
# with tooling from there. Node is provided by mise locally (see .tool-versions)
# or by the CI runner; this script no longer manages Node.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
E2E_DIR="${DIR}/../tests"

export npm_config_loglevel=error

current_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)"
if [ "$current_major" -lt 18 ]; then
  echo "Serving the report requires Node.js 18+ (this project pins Node via .tool-versions)."
  echo "Current Node: $(node -v 2>/dev/null || echo 'not found')"
  echo "Install mise (https://mise.jdx.dev) and run \`mise install\`, or run with a supported Node directly."
  exit 1
fi

cd "$E2E_DIR"
npm run report
