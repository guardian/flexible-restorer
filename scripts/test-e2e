#!/usr/bin/env bash

set -euo pipefail

E2E_NODE_VERSION="${E2E_NODE_VERSION:-20}"
TEST_ARGS=("$@")

current_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)"

run_playwright() {
  local -a cmd_prefix=("$@")
  "${cmd_prefix[@]}" npm exec playwright install chromium
  # Generate Playwright tests from the BDD feature files before running.
  "${cmd_prefix[@]}" npm exec bddgen
  if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
    "${cmd_prefix[@]}" npm exec playwright test -- "${TEST_ARGS[@]}"
  else
    "${cmd_prefix[@]}" npm exec playwright test
  fi
}

if [ "$current_major" -ge 18 ]; then
  run_playwright
  exit 0
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm install "$E2E_NODE_VERSION" >/dev/null
  run_playwright nvm exec "$E2E_NODE_VERSION"
  exit 0
fi

echo "Playwright requires Node.js 18+."
echo "Current Node: $(node -v 2>/dev/null || echo 'not found')"
echo "Install nvm and run again, or run with Node >=18 directly."
echo "Optional override: E2E_NODE_VERSION=22 npm run test:e2e"
exit 1
