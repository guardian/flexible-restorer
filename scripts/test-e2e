#!/usr/bin/env bash

set -euo pipefail

E2E_NODE_VERSION="${E2E_NODE_VERSION:-20}"
TEST_ARGS=("$@")

# The e2e suite lives in its own sub-package (tests/) with its own
# package.json / node_modules, so it can target a modern Node independently of
# the main app build (which stays on the older Node pinned by the root .nvmrc).
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
E2E_DIR="${DIR}/../tests"

# Quiet npm's deprecated-config warnings ("npm warn config ...") that are
# printed before every `npm exec` call.
export npm_config_loglevel=error

current_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)"

run_playwright() {
  # Run everything inside the e2e sub-package so its own node_modules and
  # playwright.config.js are used.
  cd "$E2E_DIR"
  # Ensure Node dependencies are present (and built against the Node version
  # selected above) before invoking any npm exec / Playwright commands.
  npm install
  # Install the Chromium browser only when it isn't already present, so repeated
  # local runs skip the download/verify step entirely.
  if ! npm exec -- node -e \
    "require('fs').accessSync(require('@playwright/test').chromium.executablePath())" \
    >/dev/null 2>&1; then
    npm exec playwright install chromium
  fi
  # Generate Playwright tests from the BDD feature files before running.
  npm exec bddgen
  if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
    npm exec playwright test -- "${TEST_ARGS[@]}"
  else
    npm exec playwright test
  fi
}

if [ "$current_major" -ge 18 ]; then
  run_playwright
  exit 0
fi

export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck disable=SC1090
  . "$NVM_DIR/nvm.sh"
  nvm install "$E2E_NODE_VERSION" >/dev/null
  # Switch the shell to the right Node once, rather than wrapping every command
  # in `nvm exec` (which prints a "Running node vX" banner per command).
  nvm use "$E2E_NODE_VERSION" >/dev/null
  run_playwright
  exit 0
fi

echo "Playwright requires Node.js 18+."
echo "Current Node: $(node -v 2>/dev/null || echo 'not found')"
echo "Install nvm and run again, or run with Node >=18 directly."
echo "Optional override: E2E_NODE_VERSION=22 npm run test:e2e"
exit 1
