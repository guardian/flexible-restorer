#!/usr/bin/env bash

set -euo pipefail

TEST_ARGS=("$@")

# The e2e suite lives in its own sub-package (tests/) with its own
# package.json / node_modules. Node is provided by mise locally (see
# .tool-versions) or by the CI runner; this script no longer manages Node.
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
E2E_DIR="${DIR}/../tests"

# Quiet npm's deprecated-config warnings ("npm warn config ...") that are
# printed before every `npm exec` call.
export npm_config_loglevel=error

current_major="$(node -p "process.versions.node.split('.')[0]" 2>/dev/null || echo 0)"
if [ "$current_major" -lt 18 ]; then
  echo "Playwright requires Node.js 18+ (this project pins Node via .tool-versions)."
  echo "Current Node: $(node -v 2>/dev/null || echo 'not found')"
  echo "Install mise (https://mise.jdx.dev) and run \`mise install\`, or run with a supported Node directly."
  exit 1
fi

# Run everything inside the e2e sub-package so its own node_modules and
# playwright.config.js are used.
cd "$E2E_DIR"
# Install Node dependencies only when they are missing or the lockfile has
# changed since the last install. `npm ci` is reproducible and faster; the
# marker file npm writes on install lets us skip it entirely on unchanged runs.
if [ ! -d node_modules ] || [ package-lock.json -nt node_modules/.package-lock.json ]; then
  npm ci
fi
# Install the Chromium browser only when it isn't already present, so repeated
# local runs skip the download/verify step entirely.
if ! npm exec -- node -e \
  "require('fs').accessSync(require('@playwright/test').chromium.executablePath())" \
  >/dev/null 2>&1; then
  npm exec playwright install chromium
fi
# Generate Playwright tests from the BDD feature files before running.
npm exec bddgen
if [ "${#TEST_ARGS[@]}" -gt 0 ]; then
  npm exec playwright test -- "${TEST_ARGS[@]}"
else
  npm exec playwright test
fi
