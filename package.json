{
    "name": "composer-restorer",
    "workspaces": [
        "e2e-tests"
    ],
    "scripts": {
        "dev": "vite --host",
        "build": "tsc && vite build",
        "build:watch": "vite build --watch",
        "dev:local": "tsx ./e2e-tests/images/run-dev-local.ts",
        "dev:local:prod": "APP_MODE=prod tsx ./e2e-tests/images/run-dev-local.ts",
        "test:unit": "jest",
        "lint": "eslint public/src/app --no-error-on-unmatched-pattern",
        "lint:fix": "eslint public/src/app --fix --no-error-on-unmatched-pattern",
        "bddgen": "bddgen --config=e2e-tests/playwright.config.js",
        "test": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js",
        "test:ci": "START_LOCAL_INFRA=true playwright test --config=e2e-tests/playwright.config.js",
        "test:ui": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js --ui-host=0.0.0.0 --ui-port=9323"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@guardian/stand": "^0.0.60",
        "@reduxjs/toolkit": "^2.12.0",
        "bootstrap": "^3.4.1",
        "flatten": "^1.0.3",
        "html-react-parser": "^5.2.17",
        "lodash.get": "^4.4.2",
        "moment": "^2.29.4",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-aria-components": "^1.19.0",
        "react-dom": "^18.3.1",
        "react-redux": "^9.3.0"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@guardian/eslint-config": "14.0.1",
        "@guardian/prettier": "5.0.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.6.4",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-jest": "^30.5.1",
        "babel-loader": "^10.1.1",
        "css-loader": "^7.1.2",
        "eslint": "^9.39.2",
        "eslint-plugin-prettier": "^5.5.4",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "mini-css-extract-plugin": "^2.9.2",
        "prettier": "^3.8.3",
        "raw-loader": "^4.0.2",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "webpack": "^5.97.1",
        "webpack-cli": "^5.1.4"
    },
    "prettier": "@guardian/prettier"
}
