{
    "name": "composer-restorer",
    "workspaces": [
        "e2e-tests"
    ],
    "imports": {
        "#.storybook/preview": "./.storybook/preview.tsx",
        "#.storybook/mockData": "./.storybook/mockData.ts"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "tsc -b && vite build",
        "build:watch": "vite build --watch",
        "storybook": "storybook dev -p 6006 --host 0.0.0.0",
        "storybook:typecheck": "tsc -p tsconfig.storybook.json",
        "storybook:build": "npm run storybook:typecheck && storybook build",
        "dev:local": "tsx ./e2e-tests/images/run-dev-local.ts",
        "dev:local:prod": "APP_MODE=prod tsx ./e2e-tests/images/run-dev-local.ts",
        "test:unit": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint public/src/app --no-error-on-unmatched-pattern",
        "lint:fix": "eslint public/src/app --fix --no-error-on-unmatched-pattern",
        "bddgen": "bddgen --config=e2e-tests/playwright.config.js",
        "test": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js",
        "test:ci": "START_LOCAL_INFRA=true playwright test --config=e2e-tests/playwright.config.js",
        "test:ui": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js --ui-host=0.0.0.0 --ui-port=9323",
        "chromatic": "chromatic --exit-zero-on-changes --build-script-name storybook:build"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@guardian/stand": "^0.0.60",
        "@reduxjs/toolkit": "^2.12.0",
        "bootstrap": "^3.4.1",
        "date-fns": "^4.4.0",
        "flatten": "^1.0.3",
        "html-react-parser": "^5.2.17",
        "lodash.get": "^4.4.2",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-aria-components": "^1.19.0",
        "react-dom": "^18.3.1",
        "react-redux": "^9.3.0"
    },
    "devDependencies": {
        "@guardian/eslint-config": "14.0.1",
        "@guardian/prettier": "5.0.0",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "^26.6.4",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "chromatic": "^18.13.1",
        "eslint": "^9.39.2",
        "eslint-plugin-prettier": "^5.5.4",
        "jsdom": "^25.0.1",
        "msw": "^2.15.0",
        "msw-storybook-addon": "^3.0.3",
        "prettier": "^3.8.3",
        "storybook": "^10.6.2",
        "typescript": "^5.9.3",
        "vite": "^8.3.3",
        "vite-plugin-compression2": "^2.5.3",
        "vitest": "^3.2.4"
    },
    "prettier": "@guardian/prettier"
}
