{
    "name": "composer-restorer",
    "workspaces": [
        "e2e-tests"
    ],
    "scripts": {
        "build": "webpack --mode=production",
        "dev": "webpack --mode=development --watch",
        "dev:local": "tsx ./e2e-tests/images/run-dev-local.ts",
        "dev:local:prod": "APP_MODE=prod tsx ./e2e-tests/images/run-dev-local.ts",
        "test:unit": "jest",
        "bddgen": "bddgen --config=e2e-tests/playwright.config.js",
        "test": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js",
        "test:ci": "START_LOCAL_INFRA=true playwright test --config=e2e-tests/playwright.config.js",
        "test:ui": "npm run bddgen && playwright test --config=e2e-tests/playwright.config.js --ui-host=0.0.0.0 --ui-port=9323"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@guardian/stand": "^0.0.60",
        "@reduxjs/toolkit": "^2.12.0",
        "angular": "^1.8.3",
        "angular-route": "^1.8.3",
        "angular-sanitize": "^1.8.3",
        "bootstrap": "^3.4.1",
        "flatten": "^1.0.3",
        "html-react-parser": "^5.2.17",
        "lodash.get": "^4.4.2",
        "moment": "^2.29.4",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-aria-components": "^1.19.0",
        "react-dom": "^18.3.1",
        "react-redux": "^9.3.0",
        "react2angular": "^4.0.6"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-react": "^8.0.1",
        "@babel/preset-typescript": "^8.0.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@types/jest": "^30.0.0",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "babel-jest": "^30.5.1",
        "babel-loader": "^10.1.1",
        "css-loader": "^7.1.2",
        "jest": "^30.5.1",
        "jest-environment-jsdom": "^30.5.1",
        "mini-css-extract-plugin": "^2.9.2",
        "raw-loader": "^4.0.2",
        "sass": "^1.83.0",
        "sass-loader": "^16.0.4",
        "typescript": "^5.9.3",
        "webpack": "^5.97.1",
        "webpack-cli": "^5.1.4"
    }
}
