#!/usr/bin/env bash

set -euo pipefail

if [[ "${1:-}" != "setup-app" || -z "${2:-}" ]]; then
  echo "Usage: dev-nginx setup-app <mapping-yml>" >&2
  exit 1
fi

MAPPING_FILE="$2"
if [[ ! -f "$MAPPING_FILE" ]]; then
  echo "Mapping file not found: $MAPPING_FILE" >&2
  exit 1
fi

PREFIX="$(awk -F: '/^[[:space:]]*(-[[:space:]]*)?prefix:[[:space:]]*/ { v=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); gsub(/^"|"$/, "", v); gsub(/^'"'"'|'"'"'$/, "", v); print v; exit }' "$MAPPING_FILE")"
PORT="$(awk -F: '/^[[:space:]]*(-[[:space:]]*)?port:[[:space:]]*/ { v=$2; gsub(/^[[:space:]]+|[[:space:]]+$/, "", v); gsub(/^"|"$/, "", v); gsub(/^'"'"'|'"'"'$/, "", v); print v; exit }' "$MAPPING_FILE")"

if [[ -z "$PREFIX" || -z "$PORT" ]]; then
  echo "Could not parse prefix/port from $MAPPING_FILE" >&2
  exit 1
fi

DOMAIN="${PREFIX}.local.dev-gutools.co.uk"
CERT_DIR="/etc/nginx/certs"
CERT_FILE="$CERT_DIR/${DOMAIN}.crt"
KEY_FILE="$CERT_DIR/${DOMAIN}.key"
CONF_FILE="/etc/nginx/conf.d/${PREFIX}.conf"

mkdir -p "$CERT_DIR"
if [[ ! -f "$CERT_FILE" || ! -f "$KEY_FILE" ]]; then
  openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout "$KEY_FILE" \
    -out "$CERT_FILE" \
    -subj "/CN=${DOMAIN}" >/dev/null 2>&1
fi

cat > "$CONF_FILE" <<EOF
server {
    listen 80;
    server_name ${DOMAIN};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate ${CERT_FILE};
    ssl_certificate_key ${KEY_FILE};

    location / {
        proxy_pass http://127.0.0.1:${PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

echo "Configured nginx for https://${DOMAIN} -> 127.0.0.1:${PORT}"
