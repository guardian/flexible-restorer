              ],
            },
            {
              "Action": "s3:ListBucket",
              "Effect": "Allow",
              "Resource": [
                "arn:aws:s3:::flexible-snapshotter-code",
                "arn:aws:s3:::flexible-secondary-snapshotter-code",
